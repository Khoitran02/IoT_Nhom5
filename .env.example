# =============================================================================
# Sao chép thành .env rồi sửa:   cp .env.example .env
# KHÔNG commit file .env lên Git (đã nằm trong .gitignore).
# =============================================================================

# ---- Phiên bản image (ghim cố định, không dùng latest) ----------------------
# Hãy chạy `docker pull` thử từng image trước khi dùng. Tag nào không có thì lùi về bản liền trước.
EMQX_VERSION=5.8.0            # dòng 5.8.x; nên nâng lên patch cao nhất có trên Docker Hub
IOTA_VERSION=3.13.0
ORION_VERSION=4.7.0           # nếu không có tag này, thử 4.4.0
MONGO_VERSION=8.0             # máy CPU cũ không có AVX: dùng 4.4 (và đổi healthcheck sang `mongo`)
QL_VERSION=1.0.0
CRATE_VERSION=4.6.7           # QuantumLeap chỉ được kiểm thử tới 4.6.x
GRAFANA_VERSION=11.0.0        # chưa kiểm tra; có thể nâng lên bản stable mới hơn
NODERED_VERSION=4.0.2         # chưa kiểm tra; chọn tag cố định thuộc dòng 4.x

# ---- Mật khẩu (BẮT BUỘC đổi) ------------------------------------------------
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=change-me-emqx
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- Mạng -------------------------------------------------------------------
# Các cổng quản trị/CSDL chỉ mở trên máy này. Khi tách nhiều máy (bước 2), đổi thành
# 0.0.0.0 hoặc IP của VPN, kèm tường lửa.
BIND_ADDR=127.0.0.1
# Cổng MQTT mở ra ngoài để simulator, Wokwi (qua tunnel) hoặc máy khác kết nối.
MQTT_BIND_ADDR=0.0.0.0

# ---- Tài nguyên và log ------------------------------------------------------
CRATE_HEAP_SIZE=1g            # tối đa khoảng một nửa giới hạn bộ nhớ của container (2g)
ORION_LOG_LEVEL=ERROR         # đổi sang DEBUG khi gỡ lỗi
IOTA_LOG_LEVEL=INFO
QL_LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh

# ---- Xác thực MQTT cho IoT Agent (dùng sau khi bật xác thực trên EMQX) -------
# MQTT_USER=iotagent
# MQTT_PASSWORD=change-me-mqtt
